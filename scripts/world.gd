extends Node3D
## PHASE 2 world: procedural terrain (hills + river valley), water, trees, rocks, sky and fog.
##
## ASSETS: trees and rocks use real models if one of these files exists (.glb, .gltf or .fbx),
## otherwise simple low-poly stand-ins are generated by code (they are NOT final art):
##   res://assets/environment/tree.glb / tree.gltf / tree.fbx
##   res://assets/environment/rock.glb / rock.gltf / rock.fbx
## Everything is drawn with MultiMesh (one draw call per part) to stay light on phones.

const SIZE := 240.0  # world is SIZE x SIZE metres, centred on the origin
const RES := 120  # quads per side (cell = 2 m)
const MAX_HEIGHT := 16.0
const WATER_LEVEL := -0.6
const TREE_COUNT := 400
const ROCK_COUNT := 90
const TREE_MODELS := [
	"res://assets/environment/tree.glb",
	"res://assets/environment/tree.gltf",
	"res://assets/environment/tree.fbx",
]
const ROCK_MODELS := [
	"res://assets/environment/rock.glb",
	"res://assets/environment/rock.gltf",
	"res://assets/environment/rock.fbx",
]
const TREE_MODEL_SCALE := 1.0
const ROCK_MODEL_SCALE := 1.0

## Game clock: 2 game minutes per real second (one full day = 12 real minutes).
var time_minutes := 7.0 * 60.0
var day := 1
var _sun: DirectionalLight3D
var _wolf_timer := 8.0
var _structures: Array = []  # placed campfires / shelters, for saving
const WolfScript := preload("res://scripts/wolf.gd")
const MAX_WOLVES := 3
var _env: Environment
var _sky_mat: ProceduralSkyMaterial

var _noise := FastNoiseLite.new()
var _detail := FastNoiseLite.new()
var _forest := FastNoiseLite.new()
var _heights := PackedFloat32Array()
var _half := SIZE * 0.5
var _step := SIZE / float(RES)

# Gatherable resources: index i matches MultiMesh instance i.
var _tree_points := PackedVector3Array()
var _tree_hp := PackedInt32Array()
var _tree_reach := PackedFloat32Array()
var _tree_shapes: Array[CollisionShape3D] = []
var _tree_mms: Array[MultiMesh] = []
var _tree_placements: Array[Transform3D] = []
var _tree_locals: Array[Transform3D] = []
var _rock_points := PackedVector3Array()
var _rock_hp := PackedInt32Array()
var _rock_reach := PackedFloat32Array()
var _rock_shapes: Array[CollisionShape3D] = []
var _rock_mms: Array[MultiMesh] = []
var _rock_placements: Array[Transform3D] = []
var _rock_locals: Array[Transform3D] = []


func _init() -> void:
	_noise.seed = 1337
	_noise.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	_noise.frequency = 0.011
	_noise.fractal_type = FastNoiseLite.FRACTAL_FBM
	_noise.fractal_octaves = 4

	_detail.seed = 4242
	_detail.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	_detail.frequency = 0.09

	_forest.seed = 99
	_forest.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	_forest.frequency = 0.03


func _ready() -> void:
	var rng := RandomNumberGenerator.new()
	rng.seed = 20261113
	_build_environment()
	_build_terrain()
	_build_water()
	_build_boundary()
	_build_trees(rng)
	_build_rocks(rng)
	_build_pickups(rng)


## Ground height at a world position. Also used by main.gd to place the player.
func height_at(x: float, z: float) -> float:
	var n := _noise.get_noise_2d(x, z) * 0.5 + 0.5
	var h := n * MAX_HEIGHT
	h += _detail.get_noise_2d(x, z) * 0.4

	# Flat, safe area around the spawn point.
	var spawn_blend := smoothstep(14.0, 40.0, Vector2(x, z).length())
	h = lerpf(2.0, h, spawn_blend)

	# A winding river valley.
	var river_x := sin(z * 0.03) * 28.0 + 38.0
	var valley := 1.0 - smoothstep(4.0, 22.0, absf(x - river_x))
	h = lerpf(h, WATER_LEVEL - 1.4, valley)
	return h


# ---------- sky, light, fog ----------

func _build_environment() -> void:
	var sky_mat := ProceduralSkyMaterial.new()
	sky_mat.sky_top_color = Color(0.25, 0.47, 0.78)
	sky_mat.sky_horizon_color = Color(0.68, 0.80, 0.90)
	sky_mat.ground_horizon_color = Color(0.68, 0.80, 0.90)
	sky_mat.ground_bottom_color = Color(0.25, 0.30, 0.25)
	var sky := Sky.new()
	sky.sky_material = sky_mat
	_sky_mat = sky_mat

	var env := Environment.new()
	env.background_mode = Environment.BG_SKY
	env.sky = sky
	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.ambient_light_energy = 0.6
	env.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	env.fog_enabled = true
	env.fog_light_color = Color(0.70, 0.78, 0.86)
	env.fog_density = 0.004

	_env = env
	var world_env := WorldEnvironment.new()
	world_env.environment = env
	add_child(world_env)

	var sun := DirectionalLight3D.new()
	sun.rotation_degrees = Vector3(-48.0, -35.0, 0.0)
	sun.light_color = Color(1.0, 0.96, 0.88)
	sun.light_energy = 0.9
	sun.shadow_enabled = true
	sun.directional_shadow_max_distance = 70.0
	add_child(sun)
	_sun = sun


## Wolves come out at night near the player and leave when the sun is up.
func _update_wolves(delta: float) -> void:
	var night := time_minutes > 19.0 * 60.0 or time_minutes < 5.0 * 60.0
	var wolves := get_tree().get_nodes_in_group("wolf")
	if not night:
		if time_minutes > 6.0 * 60.0:
			for w in wolves:
				w.queue_free()
		return
	_wolf_timer -= delta
	if _wolf_timer > 0.0 or wolves.size() >= MAX_WOLVES:
		return
	_wolf_timer = 12.0
	var player := get_parent().get_node_or_null("Player") as Node3D
	if player == null:
		return
	for attempt in 12:
		var a := randf() * TAU
		var r := randf_range(32.0, 44.0)
		var x := player.global_position.x + cos(a) * r
		var z := player.global_position.z + sin(a) * r
		if absf(x) > 105.0 or absf(z) > 105.0:
			continue
		var h := height_at(x, z)
		if h < WATER_LEVEL + 0.8:
			continue
		var wolf := WolfScript.new()
		wolf.setup(self)
		wolf.position = Vector3(x, h, z)
		add_child(wolf)
		return


## Day / night: moves the sun, changes the sky, fog and ambient light.
func _process(delta: float) -> void:
	time_minutes += delta * 2.0
	if time_minutes >= 1440.0:
		time_minutes -= 1440.0
		day += 1
	if _sun == null:
		return
	var t := time_minutes / 1440.0
	var elev := sin((t - 0.25) * TAU)  # -1 midnight .. +1 noon, 0 at 06:00 and 18:00
	var day_f := clampf(elev * 3.0, 0.0, 1.0)
	var glow := clampf(1.0 - absf(elev) * 4.0, 0.0, 1.0)  # sunrise / sunset warmth

	_update_wolves(delta)
	_sun.rotation_degrees = Vector3(-elev * 70.0 - 8.0, -35.0 + t * 120.0, 0.0)
	_sun.light_energy = 0.9 * day_f
	_sun.shadow_enabled = day_f > 0.05
	_sun.light_color = Color(1.0, 0.96, 0.88).lerp(Color(1.0, 0.62, 0.35), glow)

	var top := Color(0.02, 0.03, 0.09).lerp(Color(0.25, 0.47, 0.78), day_f)
	var horizon := Color(0.05, 0.07, 0.15).lerp(Color(0.68, 0.80, 0.90), day_f)
	horizon = horizon.lerp(Color(0.95, 0.55, 0.30), glow * 0.7)
	_sky_mat.sky_top_color = top
	_sky_mat.sky_horizon_color = horizon
	_sky_mat.ground_horizon_color = horizon
	_sky_mat.ground_bottom_color = Color(0.02, 0.03, 0.04).lerp(Color(0.25, 0.30, 0.25), day_f)
	_env.fog_light_color = horizon
	_env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	_env.ambient_light_color = Color(0.14, 0.17, 0.30).lerp(Color(0.80, 0.88, 1.0), day_f)
	_env.ambient_light_energy = lerpf(0.55, 0.6, day_f)


# ---------- terrain ----------

func _h(ix: int, iz: int) -> float:
	var n := RES + 1
	return _heights[clampi(iz, 0, RES) * n + clampi(ix, 0, RES)]


func _build_terrain() -> void:
	var n := RES + 1
	_heights.resize(n * n)
	for iz in n:
		for ix in n:
			_heights[iz * n + ix] = height_at(-_half + ix * _step, -_half + iz * _step)

	var verts := PackedVector3Array()
	var normals := PackedVector3Array()
	var colors := PackedColorArray()
	var indices := PackedInt32Array()

	for iz in n:
		for ix in n:
			var x := -_half + ix * _step
			var z := -_half + iz * _step
			var h := _h(ix, iz)
			var nrm := Vector3(
				_h(ix - 1, iz) - _h(ix + 1, iz),
				2.0 * _step,
				_h(ix, iz - 1) - _h(ix, iz + 1)
			).normalized()
			verts.push_back(Vector3(x, h, z))
			normals.push_back(nrm)
			colors.push_back(_terrain_color(h, nrm.y, x, z))

	for iz in RES:
		for ix in RES:
			var i0 := iz * n + ix
			var i1 := i0 + 1
			var i2 := i0 + n
			var i3 := i2 + 1
			indices.push_back(i0)
			indices.push_back(i1)
			indices.push_back(i2)
			indices.push_back(i1)
			indices.push_back(i3)
			indices.push_back(i2)

	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = verts
	arrays[Mesh.ARRAY_NORMAL] = normals
	arrays[Mesh.ARRAY_COLOR] = colors
	arrays[Mesh.ARRAY_INDEX] = indices

	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)

	var mat := StandardMaterial3D.new()
	mat.vertex_color_use_as_albedo = true
	mat.roughness = 1.0
	mesh.surface_set_material(0, mat)

	var body := StaticBody3D.new()
	body.name = "Terrain"
	body.collision_layer = 1

	var mesh_inst := MeshInstance3D.new()
	mesh_inst.mesh = mesh
	body.add_child(mesh_inst)

	var shape := CollisionShape3D.new()
	shape.shape = mesh.create_trimesh_shape()
	body.add_child(shape)

	add_child(body)


func _terrain_color(h: float, normal_y: float, x: float, z: float) -> Color:
	var grass_a := Color(0.27, 0.43, 0.20)
	var grass_b := Color(0.34, 0.49, 0.22)
	var rock := Color(0.44, 0.41, 0.37)
	var sand := Color(0.60, 0.54, 0.38)

	var variation := _detail.get_noise_2d(x * 2.0, z * 2.0) * 0.5 + 0.5
	var c := grass_a.lerp(grass_b, variation)
	c = c.lerp(rock, smoothstep(11.0, 14.5, h))
	c = c.lerp(rock, smoothstep(0.18, 0.40, 1.0 - normal_y))
	c = c.lerp(sand, 1.0 - smoothstep(WATER_LEVEL + 0.2, WATER_LEVEL + 1.4, h))
	return c


# ---------- water ----------

func _build_water() -> void:
	var plane := PlaneMesh.new()
	plane.size = Vector2(SIZE, SIZE)
	var mat := StandardMaterial3D.new()
	mat.albedo_color = Color(0.10, 0.30, 0.42, 0.72)
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.roughness = 0.1
	mat.metallic = 0.3
	plane.material = mat

	var inst := MeshInstance3D.new()
	inst.name = "Water"
	inst.mesh = plane
	inst.position = Vector3(0.0, WATER_LEVEL, 0.0)
	inst.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(inst)


# ---------- invisible walls at the world edge ----------

func _build_boundary() -> void:
	var body := StaticBody3D.new()
	body.name = "Boundary"
	body.collision_layer = 1
	var walls := [
		[Vector3(0.0, 20.0, -_half), Vector3(SIZE, 60.0, 2.0)],
		[Vector3(0.0, 20.0, _half), Vector3(SIZE, 60.0, 2.0)],
		[Vector3(-_half, 20.0, 0.0), Vector3(2.0, 60.0, SIZE)],
		[Vector3(_half, 20.0, 0.0), Vector3(2.0, 60.0, SIZE)],
	]
	for w in walls:
		var cs := CollisionShape3D.new()
		var bs := BoxShape3D.new()
		bs.size = w[1]
		cs.shape = bs
		cs.position = w[0]
		body.add_child(cs)
	add_child(body)


# ---------- placement helpers ----------

func _random_land_point(rng: RandomNumberGenerator, min_dist: float, forest_only: bool) -> Vector3:
	for attempt in 40:
		var x := rng.randf_range(-_half + 8.0, _half - 8.0)
		var z := rng.randf_range(-_half + 8.0, _half - 8.0)
		if Vector2(x, z).length() < min_dist:
			continue
		if forest_only and _forest.get_noise_2d(x, z) < -0.15:
			continue
		var h := height_at(x, z)
		if h < WATER_LEVEL + 1.0:
			continue
		var steep := maxf(absf(height_at(x + 1.5, z) - h), absf(height_at(x, z + 1.5) - h))
		if steep > 1.5:
			continue
		return Vector3(x, h, z)
	return Vector3.INF


func _land_point_near_spawn(rng: RandomNumberGenerator, min_r: float, max_r: float) -> Vector3:
	for attempt in 40:
		var angle := rng.randf() * TAU
		var r := rng.randf_range(min_r, max_r)
		var x := cos(angle) * r
		var z := sin(angle) * r
		var h := height_at(x, z)
		if h < WATER_LEVEL + 1.0:
			continue
		return Vector3(x, h, z)
	return Vector3.INF


## Reads every mesh out of the first model file that exists. Returns [] if none is there.
func _collect_meshes(paths: Array, model_scale: float) -> Array:
	var out := []
	var path := ""
	for candidate in paths:
		if ResourceLoader.exists(str(candidate)):
			path = str(candidate)
			break
	if path == "":
		return out
	var scene := load(path) as PackedScene
	if scene == null:
		return out
	var root := scene.instantiate()
	var scale_xf := Transform3D(Basis().scaled(Vector3(model_scale, model_scale, model_scale)), Vector3.ZERO)
	for found in root.find_children("*", "MeshInstance3D", true, false):
		var mi := found as MeshInstance3D
		if mi == null or mi.mesh == null:
			continue
		var xf := Transform3D.IDENTITY
		var node: Node = mi
		while node != null and node != root:
			if node is Node3D:
				xf = (node as Node3D).transform * xf
			node = node.get_parent()
		out.append({"mesh": mi.mesh, "xform": scale_xf * xf})
	root.free()
	return out


func _spawn_instances(parts: Array, placements: Array[Transform3D], node_name: String) -> Array[MultiMesh]:
	var made: Array[MultiMesh] = []
	if placements.is_empty():
		return made
	for part in parts:
		var local: Transform3D = part["xform"]
		var mm := MultiMesh.new()
		mm.transform_format = MultiMesh.TRANSFORM_3D
		mm.mesh = part["mesh"]
		mm.instance_count = placements.size()
		for i in placements.size():
			mm.set_instance_transform(i, placements[i] * local)
		var inst := MultiMeshInstance3D.new()
		inst.name = node_name
		inst.multimesh = mm
		add_child(inst)
		made.append(mm)
	return made


# ---------- trees ----------

func _build_trees(rng: RandomNumberGenerator) -> void:
	var placements: Array[Transform3D] = []
	var colliders := StaticBody3D.new()
	colliders.name = "TreeColliders"
	colliders.collision_layer = 1
	add_child(colliders)

	for i in TREE_COUNT:
		var p := _random_land_point(rng, 8.0, true)
		if not p.is_finite():
			continue
		var s := rng.randf_range(0.8, 1.5)
		var rot_basis := Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3(s, s, s))
		placements.append(Transform3D(rot_basis, p))

		var cyl := CylinderShape3D.new()
		cyl.radius = 0.4 * s
		cyl.height = 3.0 * s
		var shape := CollisionShape3D.new()
		shape.shape = cyl
		shape.position = p + Vector3(0.0, 1.5 * s, 0.0)
		colliders.add_child(shape)
		_tree_points.append(p)
		_tree_hp.append(5)
		_tree_reach.append(0.4 * s + 1.7)
		_tree_shapes.append(shape)

	var parts := _collect_meshes(TREE_MODELS, TREE_MODEL_SCALE)
	if parts.is_empty():
		parts = _standin_tree_parts()
	_tree_mms = _spawn_instances(parts, placements, "Trees")
	_tree_placements = placements
	for part in parts:
		_tree_locals.append(part["xform"])


func _standin_tree_parts() -> Array:
	var trunk := CylinderMesh.new()
	trunk.top_radius = 0.22
	trunk.bottom_radius = 0.34
	trunk.height = 3.0
	trunk.radial_segments = 6
	trunk.rings = 1
	var trunk_mat := StandardMaterial3D.new()
	trunk_mat.albedo_color = Color(0.32, 0.21, 0.12)
	trunk_mat.roughness = 1.0
	trunk.material = trunk_mat

	var leaf_mat := StandardMaterial3D.new()
	leaf_mat.albedo_color = Color(0.12, 0.34, 0.14)
	leaf_mat.roughness = 1.0

	# three stacked cones (wide at the bottom, narrow at the top) look like a pine
	var parts := [{"mesh": trunk, "xform": Transform3D(Basis.IDENTITY, Vector3(0.0, 1.5, 0.0))}]
	var layers := [[2.3, 2.6, 3.0], [1.75, 2.4, 4.4], [1.2, 2.2, 5.7]]  # radius, height, centre y
	for layer in layers:
		var cone := CylinderMesh.new()
		cone.top_radius = 0.0
		cone.bottom_radius = float(layer[0])
		cone.height = float(layer[1])
		cone.radial_segments = 8
		cone.rings = 1
		cone.material = leaf_mat
		parts.append({"mesh": cone, "xform": Transform3D(Basis.IDENTITY, Vector3(0.0, float(layer[2]), 0.0))})
	return parts


# ---------- rocks ----------

func _build_rocks(rng: RandomNumberGenerator) -> void:
	var placements: Array[Transform3D] = []
	var colliders := StaticBody3D.new()
	colliders.name = "RockColliders"
	colliders.collision_layer = 1
	add_child(colliders)

	for i in ROCK_COUNT:
		var p := _random_land_point(rng, 7.0, false)
		if not p.is_finite():
			continue
		var sx := rng.randf_range(0.8, 2.6)
		var sy := rng.randf_range(0.6, 1.6)
		var sz := rng.randf_range(0.8, 2.6)
		var rot_basis := Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3(sx, sy, sz))
		placements.append(Transform3D(rot_basis, p))

		var sphere := SphereShape3D.new()
		sphere.radius = 0.8 * minf(sx, sz)
		var shape := CollisionShape3D.new()
		shape.shape = sphere
		shape.position = p + Vector3(0.0, 0.3 * sy, 0.0)
		colliders.add_child(shape)
		_rock_points.append(p)
		_rock_hp.append(4)
		_rock_reach.append(0.8 * minf(sx, sz) + 1.7)
		_rock_shapes.append(shape)

	var parts := _collect_meshes(ROCK_MODELS, ROCK_MODEL_SCALE)
	if parts.is_empty():
		parts = _standin_rock_parts()
	_rock_mms = _spawn_instances(parts, placements, "Rocks")
	_rock_placements = placements
	for part in parts:
		_rock_locals.append(part["xform"])


func _standin_rock_parts() -> Array:
	var rock := SphereMesh.new()
	rock.radius = 1.0
	rock.height = 1.6
	rock.radial_segments = 7
	rock.rings = 4
	var mat := StandardMaterial3D.new()
	mat.albedo_color = Color(0.45, 0.43, 0.40)
	mat.roughness = 1.0
	rock.material = mat
	return [{"mesh": rock, "xform": Transform3D(Basis.IDENTITY, Vector3(0.0, 0.3, 0.0))}]


# ---------- pickups (USE button collects these) ----------

func _build_pickups(rng: RandomNumberGenerator) -> void:
	for i in 8:
		var p := _land_point_near_spawn(rng, 6.0, 30.0)
		if p.is_finite():
			_add_pickup(p, "wood", 2, Color(0.45, 0.28, 0.12))
	for i in 6:
		var p := _land_point_near_spawn(rng, 8.0, 35.0)
		if p.is_finite():
			_add_pickup(p, "stone", 2, Color(0.5, 0.5, 0.55))
	for i in 12:
		var p := _land_point_near_spawn(rng, 8.0, 40.0)
		if p.is_finite():
			_add_pickup(p, "berries", 3, Color(0.75, 0.10, 0.20))
	_build_animals(rng)


const AnimalScript := preload("res://scripts/animal.gd")


func _build_animals(rng: RandomNumberGenerator) -> void:
	for i in 8:
		_spawn_animal("deer", rng, 15.0, 75.0)
	for i in 14:
		_spawn_animal("rabbit", rng, 8.0, 45.0)


func _spawn_animal(kind: String, rng: RandomNumberGenerator, min_r: float, max_r: float) -> void:
	var p := _land_point_near_spawn(rng, min_r, max_r)
	if not p.is_finite():
		return
	var a := AnimalScript.new()
	a.setup(kind, self)
	a.position = p
	add_child(a)


func _add_pickup(pos: Vector3, item_id: String, amount: int, color: Color) -> void:
	var node := Node3D.new()
	node.position = pos
	node.add_to_group("interactable")
	node.set_meta("item_id", item_id)
	node.set_meta("amount", amount)

	var mesh_inst := MeshInstance3D.new()
	var mesh := BoxMesh.new()
	mesh.size = Vector3(0.5, 0.5, 0.5)
	var mat := StandardMaterial3D.new()
	mat.albedo_color = color
	mesh.material = mat
	mesh_inst.mesh = mesh
	mesh_inst.position.y = 0.25
	node.add_child(mesh_inst)

	add_child(node)


# ---------- gathering API (used by player.gd) ----------

func nearest_tree(pos: Vector3) -> int:
	return _nearest_resource(pos, _tree_points, _tree_hp, _tree_reach)


func nearest_rock(pos: Vector3) -> int:
	return _nearest_resource(pos, _rock_points, _rock_hp, _rock_reach)


func _nearest_resource(pos: Vector3, points: PackedVector3Array, hp: PackedInt32Array, reach: PackedFloat32Array) -> int:
	var best := -1
	var best_gap := 0.0
	for i in points.size():
		if hp[i] <= 0:
			continue
		var d := Vector2(pos.x - points[i].x, pos.z - points[i].z).length()
		var gap := d - reach[i]
		if gap <= 0.0 and (best == -1 or gap < best_gap):
			best = i
			best_gap = gap
	return best


func tree_hp(i: int) -> int:
	return _tree_hp[i]


func rock_hp(i: int) -> int:
	return _rock_hp[i]


## Returns true when the tree has just been felled. `from` is where the player stands.
func hit_tree(i: int, damage: int, from: Vector3) -> bool:
	_tree_hp[i] -= damage
	_spawn_chips(_tree_points[i] + Vector3(0.0, 1.2, 0.0), Color(0.45, 0.28, 0.12))
	if _tree_hp[i] > 0:
		_set_tree_pose(i, Vector3.RIGHT, 0.06)
		get_tree().create_timer(0.1).timeout.connect(_unshake_tree.bind(i))
		return false
	_tree_shapes[i].set_deferred("disabled", true)
	_fell_tree(i, from)
	return true


func _unshake_tree(i: int) -> void:
	if _tree_hp[i] > 0:
		_set_tree_pose(i, Vector3.RIGHT, 0.0)


func _set_tree_pose(i: int, axis: Vector3, angle: float) -> void:
	var base: Transform3D = _tree_placements[i]
	var posed := Transform3D(Basis(axis, angle) * base.basis, base.origin)
	for k in _tree_mms.size():
		_tree_mms[k].set_instance_transform(i, posed * _tree_locals[k])


func _fall_step(angle: float, i: int, axis: Vector3) -> void:
	_set_tree_pose(i, axis, angle)


## The tree topples away from the player, then disappears.
func _fell_tree(i: int, from: Vector3) -> void:
	var away := _tree_points[i] - from
	away.y = 0.0
	if away.length() < 0.01:
		away = Vector3(0.0, 0.0, -1.0)
	away = away.normalized()
	var axis := Vector3.UP.cross(away).normalized()
	var tw := create_tween()
	tw.set_trans(Tween.TRANS_QUAD)
	tw.set_ease(Tween.EASE_IN)
	tw.tween_method(_fall_step.bind(i, axis), 0.0, 1.45, 0.9)
	tw.tween_callback(_hide_instance.bind(_tree_mms, i, _tree_points[i]))


## Returns true when the rock has just been used up.
func hit_rock(i: int, damage: int) -> bool:
	_rock_hp[i] -= damage
	_spawn_chips(_rock_points[i] + Vector3(0.0, 0.8, 0.0), Color(0.55, 0.55, 0.58))
	if _rock_hp[i] > 0:
		_set_rock_scale(0.94, i)
		get_tree().create_timer(0.1).timeout.connect(_set_rock_scale.bind(1.0, i))
		return false
	_rock_shapes[i].set_deferred("disabled", true)
	var tw := create_tween()
	tw.tween_method(_set_rock_scale.bind(i), 1.0, 0.001, 0.3)
	tw.tween_callback(_hide_instance.bind(_rock_mms, i, _rock_points[i]))
	return true


func _set_rock_scale(s: float, i: int) -> void:
	if _rock_hp[i] <= 0 and s > 0.999:
		return
	var base: Transform3D = _rock_placements[i]
	var posed := Transform3D(base.basis.scaled(Vector3(s, s, s)), base.origin)
	for k in _rock_mms.size():
		_rock_mms[k].set_instance_transform(i, posed * _rock_locals[k])


func _hide_instance(mms: Array[MultiMesh], i: int, p: Vector3) -> void:
	var gone := Transform3D(Basis().scaled(Vector3(0.001, 0.001, 0.001)), p)
	for mm in mms:
		mm.set_instance_transform(i, gone)


## A small burst of chips (wood or stone) when something is hit.
func _spawn_chips(pos: Vector3, color: Color) -> void:
	var mesh := BoxMesh.new()
	mesh.size = Vector3(0.09, 0.09, 0.09)
	var mat := StandardMaterial3D.new()
	mat.albedo_color = color
	mesh.material = mat

	var chips := CPUParticles3D.new()
	chips.mesh = mesh
	chips.one_shot = true
	chips.amount = 10
	chips.lifetime = 0.6
	chips.explosiveness = 1.0
	chips.direction = Vector3.UP
	chips.spread = 70.0
	chips.initial_velocity_min = 2.0
	chips.initial_velocity_max = 4.0
	chips.gravity = Vector3(0.0, -9.0, 0.0)
	chips.position = pos
	add_child(chips)
	chips.emitting = true
	get_tree().create_timer(1.2).timeout.connect(chips.queue_free)


## A picked-up item flies to the player and shrinks, instead of vanishing instantly.
func fly_pickup(node: Node3D, target: Vector3) -> void:
	var tw := create_tween()
	tw.set_parallel(true)
	tw.tween_property(node, "global_position", target, 0.25)
	tw.tween_property(node, "scale", Vector3(0.1, 0.1, 0.1), 0.25)
	tw.chain().tween_callback(node.queue_free)


func is_near_water(pos: Vector3) -> bool:
	if height_at(pos.x, pos.z) < WATER_LEVEL + 0.1:
		return true
	for k in 8:
		var a := TAU * float(k) / 8.0
		if height_at(pos.x + cos(a) * 2.5, pos.z + sin(a) * 2.5) < WATER_LEVEL:
			return true
	return false


func nearest_campfire(pos: Vector3, max_dist: float) -> Node3D:
	var best: Node3D = null
	var best_d := max_dist
	for n in get_tree().get_nodes_in_group("campfire"):
		var node := n as Node3D
		if node == null:
			continue
		var d := pos.distance_to(node.global_position)
		if d < best_d:
			best_d = d
			best = node
	return best


# ---------- building (campfire, shelter) ----------

func place_structure(kind: String, pos: Vector3, yaw: float) -> bool:
	if pos.y < WATER_LEVEL + 0.4:
		return false
	var steep := maxf(absf(height_at(pos.x + 1.5, pos.z) - pos.y), absf(height_at(pos.x, pos.z + 1.5) - pos.y))
	if steep > 1.2:
		return false
	if kind == "campfire":
		_make_campfire(pos)
		_structures.append({"kind": kind, "x": pos.x, "y": pos.y, "z": pos.z, "yaw": yaw})
		return true
	if kind == "shelter":
		_make_shelter(pos, yaw)
		_structures.append({"kind": kind, "x": pos.x, "y": pos.y, "z": pos.z, "yaw": yaw})
		return true
	return false


# ---------- saving ----------

func get_save_data() -> Dictionary:
	return {
		"time": time_minutes,
		"day": day,
		"tree_hp": Array(_tree_hp),
		"rock_hp": Array(_rock_hp),
		"structures": _structures,
	}


func apply_save_data(d: Dictionary) -> void:
	time_minutes = float(d.get("time", time_minutes))
	day = int(d.get("day", day))
	var th: Array = d.get("tree_hp", [])
	if th.size() == _tree_hp.size():
		for i in th.size():
			_tree_hp[i] = int(th[i])
			if _tree_hp[i] <= 0:
				_tree_shapes[i].set_deferred("disabled", true)
				_hide_instance(_tree_mms, i, _tree_points[i])
	var rh: Array = d.get("rock_hp", [])
	if rh.size() == _rock_hp.size():
		for i in rh.size():
			_rock_hp[i] = int(rh[i])
			if _rock_hp[i] <= 0:
				_rock_shapes[i].set_deferred("disabled", true)
				_hide_instance(_rock_mms, i, _rock_points[i])
	for s in d.get("structures", []):
		var pos := Vector3(float(s["x"]), float(s["y"]), float(s["z"]))
		if str(s["kind"]) == "campfire":
			_make_campfire(pos)
		else:
			_make_shelter(pos, float(s["yaw"]))
		_structures.append(s)


func _make_campfire(pos: Vector3) -> void:
	var fire := Node3D.new()
	fire.name = "Campfire"
	fire.position = pos
	fire.add_to_group("campfire")

	var stone_mat := StandardMaterial3D.new()
	stone_mat.albedo_color = Color(0.45, 0.45, 0.48)
	stone_mat.roughness = 1.0
	for k in 7:
		var a := TAU * float(k) / 7.0
		var sm := SphereMesh.new()
		sm.radius = 0.16
		sm.height = 0.26
		sm.radial_segments = 6
		sm.rings = 3
		sm.material = stone_mat
		var st := MeshInstance3D.new()
		st.mesh = sm
		st.position = Vector3(cos(a) * 0.55, 0.1, sin(a) * 0.55)
		fire.add_child(st)

	var log_mat := StandardMaterial3D.new()
	log_mat.albedo_color = Color(0.30, 0.19, 0.10)
	log_mat.roughness = 1.0
	for k in 3:
		var cm := CylinderMesh.new()
		cm.top_radius = 0.07
		cm.bottom_radius = 0.07
		cm.height = 0.8
		cm.radial_segments = 6
		cm.material = log_mat
		var lg := MeshInstance3D.new()
		lg.mesh = cm
		lg.position = Vector3(0.0, 0.14, 0.0)
		lg.rotation = Vector3(deg_to_rad(80.0), TAU * float(k) / 3.0, 0.0)
		fire.add_child(lg)

	var light := OmniLight3D.new()
	light.light_color = Color(1.0, 0.62, 0.25)
	light.light_energy = 1.8
	light.omni_range = 12.0
	light.position = Vector3(0.0, 0.9, 0.0)
	fire.add_child(light)

	var flame_mesh := SphereMesh.new()
	flame_mesh.radius = 0.09
	flame_mesh.height = 0.18
	flame_mesh.radial_segments = 6
	flame_mesh.rings = 3
	var flame_mat := StandardMaterial3D.new()
	flame_mat.albedo_color = Color(1.0, 0.55, 0.10)
	flame_mat.emission_enabled = true
	flame_mat.emission = Color(1.0, 0.45, 0.05)
	flame_mat.emission_energy_multiplier = 2.0
	flame_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	flame_mesh.material = flame_mat

	var flame := CPUParticles3D.new()
	flame.mesh = flame_mesh
	flame.amount = 20
	flame.lifetime = 0.8
	flame.direction = Vector3.UP
	flame.spread = 14.0
	flame.initial_velocity_min = 0.7
	flame.initial_velocity_max = 1.4
	flame.gravity = Vector3.ZERO
	flame.scale_amount_min = 0.6
	flame.scale_amount_max = 1.3
	flame.position = Vector3(0.0, 0.25, 0.0)
	fire.add_child(flame)

	add_child(fire)


func _make_shelter(pos: Vector3, yaw: float) -> void:
	var root := StaticBody3D.new()
	root.name = "Shelter"
	root.collision_layer = 1
	root.position = pos
	root.rotation.y = yaw

	var wood := StandardMaterial3D.new()
	wood.albedo_color = Color(0.40, 0.27, 0.15)
	wood.roughness = 1.0
	var thatch := StandardMaterial3D.new()
	thatch.albedo_color = Color(0.22, 0.34, 0.16)
	thatch.roughness = 1.0

	# four posts, a roof, and a back wall (the open side faces the player who built it)
	for px in [-1.5, 1.5]:
		for pz in [-1.4, 1.4]:
			_add_box_part(root, Vector3(0.2, 2.8, 0.2), Vector3(px, 0.8, pz), wood)
	_add_box_part(root, Vector3(3.6, 0.15, 3.4), Vector3(0.0, 2.25, 0.0), thatch)
	_add_box_part(root, Vector3(3.2, 2.0, 0.12), Vector3(0.0, 0.6, -1.4), wood)

	add_child(root)


func _add_box_part(parent: Node3D, size: Vector3, pos: Vector3, mat: Material) -> void:
	var bm := BoxMesh.new()
	bm.size = size
	bm.material = mat
	var mi := MeshInstance3D.new()
	mi.mesh = bm
	mi.position = pos
	parent.add_child(mi)

	var bs := BoxShape3D.new()
	bs.size = size
	var cs := CollisionShape3D.new()
	cs.shape = bs
	cs.position = pos
	parent.add_child(cs)
